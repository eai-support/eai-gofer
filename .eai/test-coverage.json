{
  "schema": "eai.test_coverage_map.v1",
  "repositories": {
    "eai-gofer": {
      "features": [
        {
          "id": "admin-portal-gofer-headless-contract",
          "description": "Side-effect-free Gofer stages 0-4 contracts, governance validation, and deterministic portable repository export for Admin Portal generation and regeneration.",
          "owned_paths": ["src/headless/**", "tests/unit/headless/**", "package.json"],
          "required_repo_tests": [
            "tests/unit/headless/validators.test.ts",
            "tests/unit/headless/exportBundle.test.ts",
            "tests/unit/headless/stageExecutor.test.ts",
            "tests/unit/headless/deliveryLineage.test.ts"
          ],
          "required_ci_checks": ["ci/quality-gates", "ci/build-test-required"],
          "required_cross_service_surfaces": ["adminportal-adminapi"],
          "required_deployed_contracts": [
            {
              "repository": "eai-testing-dev",
              "path": "tests/cross-service/contracts/adminportal-adminapi/admin-portal-gofer-governance.spec.ts"
            }
          ]
        },
        {
          "id": "customer-delivery-lineage-viewer",
          "description": "Customer-safe delivery lineage authoring, Mermaid generation, and VS Code graph viewing capped at the PublicAPI contract boundary.",
          "owned_paths": [
            ".claude/skills/gofer-documentation/**",
            ".specify/references/delivery-lineage.md",
            ".specify/scripts/node/delivery-lineage-corpus.mjs",
            ".specify/scripts/node/render-delivery-lineage.mjs",
            ".specify/skills/gofer-documentation/**",
            ".specify/templates/delivery-lineage-template.json",
            "extension/src/ui/DeliveryLineagePanel.ts",
            "extension/src/ui/deliveryLineageCorpus.ts",
            "extension/src/ui/deliveryLineageHtml.ts",
            "extension/src/ui/deliveryLineageModel.ts",
            "tests/unit/ui/deliveryLineageCorpus.test.ts",
            "tests/unit/ui/deliveryLineageViewer.test.ts"
          ],
          "required_repo_tests": [
            "tests/unit/headless/deliveryLineage.test.ts",
            "tests/unit/ui/deliveryLineageCorpus.test.ts",
            "tests/unit/ui/deliveryLineageViewer.test.ts"
          ],
          "required_ci_checks": ["ci/quality-gates", "ci/build-test-required"],
          "required_cross_service_surfaces": [],
          "required_deployed_contracts": []
        }
      ]
    }
  }
}
